// askJeni data model
// Run `npm run db:push` to apply to your local database (no migration file)
// Run `npm run db:migrate` when you're ready for versioned migrations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  EMPLOYER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // Profile relations (at most one per user)
  studentProfile  StudentProfile?
  employerProfile EmployerProfile?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// STUDENT
// ---------------------------------------------------------------------------

enum WorkType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
  VACATION_WORK
}

enum WorkLocation {
  REMOTE
  HYBRID
  IN_OFFICE
}

enum GraduationMonth {
  JUNE
  NOVEMBER
}

model StudentProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity
  slug        String  @unique // public URL: askjeni.co.za/thabo-nkosi
  firstName   String
  lastName    String
  bio         String? @db.Text
  avatarColor String  @default("#2563EB")

  // Institution
  institution       String
  degree            String
  yearOfStudy       Int
  graduationMonth   GraduationMonth
  graduationYear    Int

  // Location
  city     String
  province String
  country  String @default("ZA")

  // Availability & salary
  salaryExpectation    Int       // monthly, in Rands
  availableFrom        DateTime
  willingToRelocate    Boolean   @default(false)
  workTypePreferences  WorkType[]
  workLocationPrefs    WorkLocation[]
  preferredCity        String?

  // Links
  githubUrl   String?
  linkedinUrl String?
  portfolioUrl String?

  // Passport completion score (0–100), recomputed on profile save
  passportCompletion Int @default(0)

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills             StudentSkill[]
  projects           Project[]
  assessmentAttempts AssessmentAttempt[]
  matches            Match[]
  profileViews       ProfileView[]

  @@map("student_profiles")
}

enum SkillLevel {
  LEARNING    // self-declared, yellow chip
  CONFIDENT   // self-declared, blue chip (unverified)
  VERIFIED    // backed by a passing assessment
}

model StudentSkill {
  id        String     @id @default(cuid())
  studentId String
  skillId   String
  level     SkillLevel @default(LEARNING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id])

  @@unique([studentId, skillId])
  @@map("student_skills")
}

model Project {
  id          String   @id @default(cuid())
  studentId   String
  name        String
  description String   @db.Text
  githubUrl   String?
  liveUrl     String?
  starCount   Int?
  isInProgress Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skills      ProjectSkill[]

  @@map("projects")
}

model ProjectSkill {
  projectId String
  skillId   String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@id([projectId, skillId])
  @@map("project_skills")
}

// ---------------------------------------------------------------------------
// EMPLOYER
// ---------------------------------------------------------------------------

model EmployerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyName    String
  companyWebsite String?
  companySize    String?   // "1-10", "11-50", "51-200", "201-1000", "1000+"
  industry       String?
  city           String
  province       String
  logoUrl        String?
  description    String?   @db.Text

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@map("employer_profiles")
}

// ---------------------------------------------------------------------------
// SKILLS (master list)
// ---------------------------------------------------------------------------

enum SkillCategory {
  LANGUAGE
  FRONTEND
  BACKEND
  DATABASE
  INFRASTRUCTURE
  DATA_ML
  MOBILE
  OTHER
}

model Skill {
  id       String        @id @default(cuid())
  name     String        @unique
  category SkillCategory
  iconSlug String?       // for rendering a tech icon

  studentSkills   StudentSkill[]
  projectSkills   ProjectSkill[]
  assessments     Assessment[]
  opportunitySkills OpportunitySkill[]

  @@map("skills")
}

// ---------------------------------------------------------------------------
// ASSESSMENTS
// ---------------------------------------------------------------------------

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

model Assessment {
  id          String   @id @default(cuid())
  skillId     String
  title       String
  description String?  @db.Text
  timeLimit   Int      // minutes
  passScore   Int      @default(80) // % required to get VERIFIED badge
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  skill     Skill              @relation(fields: [skillId], references: [id])
  questions AssessmentQuestion[]
  attempts  AssessmentAttempt[]

  @@map("assessments")
}

model AssessmentQuestion {
  id           String          @id @default(cuid())
  assessmentId String
  body         String          @db.Text
  codeBlock    String?         @db.Text
  difficulty   DifficultyLevel @default(MEDIUM)
  order        Int

  assessment Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    QuestionOption[]

  @@map("assessment_questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  body       String
  isCorrect  Boolean @default(false)
  order      Int

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model AssessmentAttempt {
  id           String        @id @default(cuid())
  studentId    String
  assessmentId String
  status       AttemptStatus @default(IN_PROGRESS)
  score        Int?          // null until completed
  timeTaken    Int?          // seconds
  startedAt    DateTime      @default(now())
  completedAt  DateTime?

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessment Assessment     @relation(fields: [assessmentId], references: [id])
  answers    AttemptAnswer[]

  @@map("assessment_attempts")
}

model AttemptAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  optionId   String?
  flagged    Boolean @default(false)

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

// ---------------------------------------------------------------------------
// OPPORTUNITIES
// ---------------------------------------------------------------------------

enum OpportunityStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model Opportunity {
  id          String            @id @default(cuid())
  employerId  String
  status      OpportunityStatus @default(DRAFT)
  title       String
  description String            @db.Text
  city        String
  province    String
  workType    WorkType
  workLocation WorkLocation
  salaryMin   Int               // monthly, Rands
  salaryMax   Int
  startDate   DateTime
  closingDate DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  employer EmployerProfile  @relation(fields: [employerId], references: [id], onDelete: Cascade)
  skills   OpportunitySkill[]
  matches  Match[]

  @@map("opportunities")
}

model OpportunitySkill {
  opportunityId String
  skillId       String
  isRequired    Boolean @default(true)

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  skill       Skill       @relation(fields: [skillId], references: [id])

  @@id([opportunityId, skillId])
  @@map("opportunity_skills")
}

// ---------------------------------------------------------------------------
// MATCHING
// ---------------------------------------------------------------------------

enum InterestStatus {
  SAVED
  EXPRESSED   // student expressed interest
  VIEWED      // employer viewed the student
  SHORTLISTED
  REJECTED
}

model Match {
  id            String         @id @default(cuid())
  studentId     String
  opportunityId String
  score         Int            // 0–100 match percentage
  status        InterestStatus @default(SAVED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([studentId, opportunityId])
  @@map("matches")
}

// ---------------------------------------------------------------------------
// ANALYTICS
// ---------------------------------------------------------------------------

model ProfileView {
  id        String   @id @default(cuid())
  studentId String
  viewerType String  // "EMPLOYER" | "ANONYMOUS"
  viewerId  String?  // employerProfileId if authenticated
  createdAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("profile_views")
}
