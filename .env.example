# Copy this file to .env.local and fill in the values.
# Never commit .env.local to git.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (Docker):
#   postgresql://postgres:postgres@localhost:5432/askjeni
# Railway / Supabase / Neon: paste your connection string from the dashboard
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/askjeni"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-secret"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# OAuth providers (optional — only needed if enabling social login)
# ---------------------------------------------------------------------------
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# AI / Jeni (add when you wire up the AI assistant)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=""
